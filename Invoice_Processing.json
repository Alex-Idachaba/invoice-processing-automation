    {
      "parameters": {
        "jsCode": "const vendorRanges = {\n  \"Acme Supplies\": { min: 200, max: 800 },\n  \"Northwind Logistics\": { min: 1000, max: 5000 }\n};\n\nconst allItems = $input.all();\n\nfor (const item of allItems) {\n  const vendor = $('Parse Invoice Data').item.json.vendor;\n  const amount = $('Parse Invoice Data').item.json.amount;\n  const invoiceId = $('Parse Invoice Data').item.json.invoice_id;\n\n  const range = vendorRanges[vendor];\n\n  item.json.vendor = vendor;\n  item.json.amount = amount;\n  item.json.invoice_id = invoiceId;\n\n  if (!range) {\n    item.json.evaluation_status = \"flagged\";\n  } else if (amount >= range.min && amount <= range.max) {\n    item.json.evaluation_status = \"approved\";\n  } else {\n    item.json.evaluation_status = \"flagged\";\n  }\n}\n\nreturn allItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
